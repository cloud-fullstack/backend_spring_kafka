<!--
  Promemoria: npm install -D mjml
  Compilare: npx mjml welcome-email.mjml -o welcome-email.html
  Segnaposto Java: {{GREETING}} {{BODY}} {{CTA}} {{LOGIN_URL}} {{DISCLAIMER}} {{SUPPORT_TEXT}} {{RIGHTS}}
-->
<mjml>
  <mj-head>
    <mj-font name="Inter" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" />
    <mj-attributes>
      <mj-all font-family="Inter, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f0f4f8">
    <mj-section padding="32px 0 0 0">
      <mj-column>
        <mj-image width="48px" src="https://telemaco.app/favicon.ico" alt="Telemaco" padding-bottom="8px" />
        <mj-text font-size="13px" color="#6b7280" align="center" padding-top="0">
          telemaco.app
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff" border-radius="12px" padding="40px 32px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" color="#111827" padding-bottom="8px">
          {{GREETING}}
        </mj-text>
        <mj-text font-size="15px" color="#374151" line-height="1.6" padding-bottom="24px">
          {{BODY}}
        </mj-text>
        <mj-button
          background-color="#4F46E5"
          color="#ffffff"
          border-radius="8px"
          font-size="15px"
          font-weight="600"
          href="{{LOGIN_URL}}"
          inner-padding="14px 32px">
          {{CTA}}
        </mj-button>
        <mj-divider border-color="#e5e7eb" padding="32px 0 24px 0" />
        <mj-text font-size="13px" color="#9ca3af" line-height="1.5">
          {{DISCLAIMER}}<br/>
          {{SUPPORT_TEXT}}: <a href="mailto:support@telemaco.app" style="color:#4F46E5;text-decoration:none;">support@telemaco.app</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 0 32px 0">
      <mj-column>
        <mj-text font-size="12px" color="#9ca3af" align="center">
          © 2026 Telemaco. {{RIGHTS}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
